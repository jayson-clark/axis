{
    "name": "@axis-dsl/site",
    "version": "2.2.0",
    "private": true,
    "type": "module",
    "description": "The Axis documentation site, built with Astro Starlight",
    "scripts": {
        "generate": "node scripts/generate.mjs",
        "dev": "node scripts/generate.mjs && astro dev",
        "build": "node scripts/generate.mjs && astro build && node scripts/check-links.mjs",
        "preview": "astro preview",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "catalog:",
        "@astrojs/react": "catalog:",
        "@astrojs/starlight": "catalog:",
        "@axis-dsl/compiler": "workspace:*",
        "@axis-dsl/desmos": "workspace:*",
        "@axis-dsl/language-service": "workspace:*",
        "@axis-dsl/syntax": "workspace:*",
        "@axis-dsl/viewer": "workspace:*",
        "astro": "catalog:",
        "monaco-editor": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "unist-util-visit": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:"
    }
}
