{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Axis",
    "scopeName": "source.axis",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#config" },
        { "include": "#import" },
        { "include": "#ticker" },
        { "include": "#folder" },
        { "include": "#table" },
        { "include": "#metadata" },
        { "include": "#functions" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#variables" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.axis",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.axis",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.axis",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },

        "import": {
            "patterns": [
                {
                    "name": "keyword.control.import.axis",
                    "match": "^\\s*(import)\\b"
                },
                {
                    "name": "keyword.control.import.axis",
                    "match": "\\b(as)\\b(?=\\s*\")"
                }
            ]
        },
        "ticker": {
            "patterns": [
                {
                    "name": "keyword.control.ticker.axis",
                    "match": "^\\s*(ticker)\\b"
                }
            ]
        },
        "folder": {
            "patterns": [
                {
                    "name": "keyword.control.folder.axis",
                    "match": "\\b(folder)\\b"
                }
            ]
        },
        "table": {
            "patterns": [
                {
                    "name": "keyword.control.table.axis",
                    "match": "\\b(table)\\b"
                }
            ]
        },
        "config": {
            "patterns": [
                {
                    "name": "keyword.control.config.axis",
                    "match": "\\b(config)\\b"
                },
                {
                    "name": "variable.parameter.config.axis",
                    "match": "\\b(degreeMode|showGrid|showXAxis|showYAxis|xAxisNumbers|yAxisNumbers|polarMode|lockViewport|expressionsCollapsed|capExpressionSize|pointsOfInterest|trace|border|keypad|graphpaper)\\b"
                }
            ]
        },
        "metadata": {
            "patterns": [
                {
                    "name": "meta.metadata.axis",
                    "match": "#\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*([^,}]+)",
                    "captures": {
                        "1": { "name": "variable.parameter.axis" },
                        "2": { "name": "string.unquoted.axis" }
                    }
                },
                {
                    "name": "keyword.other.metadata.axis",
                    "match": "#\\s*(hidden|secret)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.trig.axis",
                    "match": "\\b(sin|cos|tan|csc|sec|cot|arcsin|arccos|arctan|arccsc|arcsec|arccot|sinh|cosh|tanh|csch|sech|coth)\\b"
                },
                {
                    "name": "support.function.math.axis",
                    "match": "\\b(sqrt|nthroot|abs|ln|log|exp|floor|ceil|round|sign|mod|gcd|lcm)\\b"
                },
                {
                    "name": "support.function.statistics.axis",
                    "match": "\\b(total|length|mean|median|min|max|stdev|stdevp|mad|var|varp|discretedist|random)\\b"
                },
                {
                    "name": "support.function.list.axis",
                    "match": "\\b(repeat|join|sort)\\b"
                },
                {
                    "name": "support.function.geometry.axis",
                    "match": "\\b(polygon|distance|midpoint)\\b"
                },
                {
                    "name": "support.function.color.axis",
                    "match": "\\b(rgb|hsv|okhsv|oklab|oklch)\\b"
                },
                {
                    "name": "support.function.combinatorics.axis",
                    "match": "\\b(nCr|nPr|factorial)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.greek.axis",
                    "match": "\\b(pi|tau|theta|alpha|beta|gamma|delta|epsilon|zeta|eta|iota|kappa|lambda|mu|nu|xi|rho|sigma|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Phi|Psi|Omega)\\b"
                },
                {
                    "name": "constant.language.axis",
                    "match": "\\b(e|infinity)\\b"
                },
                {
                    "name": "constant.language.boolean.axis",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "support.function.viewport.axis",
                    "match": "\\b(width|height)\\b"
                },
                {
                    "name": "keyword.operator.comprehension.axis",
                    "match": "\\bfor\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.axis",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.word.axis",
                    "match": "\\b(for|with)\\b"
                },
                {
                    "name": "keyword.operator.comparison.axis",
                    "match": "<=|>=|<|>|="
                },
                {
                    "name": "keyword.operator.arithmetic.axis",
                    "match": "\\+|-|\\*|/|\\^"
                },
                {
                    "name": "keyword.operator.arrow.axis",
                    "match": "->"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.axis",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}
