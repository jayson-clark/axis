{
    "name": "@axis-dsl/editor",
    "version": "0.0.1",
    "description": "The Axis editing surface: Monaco bound to the Axis language, themed",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@axis-dsl/language": "workspace:*"
    },
    "peerDependencies": {
        "monaco-editor": ">=0.56",
        "react": "^19"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "monaco-editor": "catalog:",
        "react": "catalog:"
    },
    "license": "MIT",
    "author": "Jayson Clark",
    "homepage": "https://github.com/jayson-clark/axis#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jayson-clark/axis.git",
        "directory": "packages/editor"
    },
    "bugs": {
        "url": "https://github.com/jayson-clark/axis/issues"
    },
    "keywords": [
        "axis",
        "axis-dsl",
        "desmos",
        "graphing",
        "dsl"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    }
}
