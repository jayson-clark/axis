{
    "name": "@axis-dsl/language-server",
    "version": "2.5.0",
    "description": "An LSP server for Axis: diagnostics, completion, hover, formatting, semantic tokens and navigation for any editor",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "axis-language-server": "./dist/bin.js"
    },
    "scripts": {
        "watch": "tsc --watch"
    },
    "dependencies": {
        "@axis-dsl/compiler": "workspace:*",
        "@axis-dsl/language-service": "workspace:*",
        "@axis-dsl/syntax": "workspace:*",
        "vscode-languageserver": "catalog:",
        "vscode-languageserver-textdocument": "catalog:",
        "vscode-uri": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "vscode-jsonrpc": "catalog:"
    },
    "license": "MIT",
    "author": "Jayson Clark",
    "homepage": "https://jayson-clark.github.io/axis/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jayson-clark/axis.git",
        "directory": "packages/language-server"
    },
    "bugs": {
        "url": "https://github.com/jayson-clark/axis/issues"
    },
    "keywords": [
        "axis",
        "axis-dsl",
        "desmos",
        "graphing",
        "dsl",
        "lsp",
        "language-server"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    }
}
