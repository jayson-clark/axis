# The .vsix carries the bundles and the assets `contributes` names, and nothing
# else: scripts/build.mjs bundles everything the extension runs into dist/, so
# neither src/ nor node_modules/ is needed at runtime.
**
!package.json
!README.md
!LICENSE
!icons/**
!dist/extension.js
!dist/server.js
!dist/viewer.js
!dist/axis.tmLanguage.json
!dist/language-configuration.json
