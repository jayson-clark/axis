{
    "name": "axis-dsl",
    "displayName": "Axis — Desmos Scripting Language",
    "description": "Previews the .axis file you have open as a live Desmos graph, with Axis language support",
    "version": "1.8.0",
    "publisher": "axis",
    "engines": {
        "vscode": "^1.134.0"
    },
    "categories": [
        "Other"
    ],
    "scripts": {
        "build": "node scripts/copy-assets.mjs",
        "watch": "tsc --watch"
    },
    "activationEvents": [
        "onLanguage:axis"
    ],
    "main": "dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "axis",
                "aliases": [
                    "Axis",
                    "axis"
                ],
                "extensions": [
                    ".axis"
                ],
                "configuration": "./dist/language-configuration.json",
                "icon": {
                    "light": "./icons/axis-light.svg",
                    "dark": "./icons/axis-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "axis",
                "scopeName": "source.axis",
                "path": "./dist/axis.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "axis.preview",
                "title": "Preview Graph",
                "category": "Axis",
                "icon": {
                    "light": "./icons/axis-action-light.svg",
                    "dark": "./icons/axis-action-dark.svg"
                }
            },
            {
                "command": "axis.previewStatus",
                "title": "Preview Server…",
                "category": "Axis"
            },
            {
                "command": "axis.stopPreviewServer",
                "title": "Stop Preview Server",
                "category": "Axis"
            }
        ],
        "configuration": {
            "title": "Axis",
            "properties": {
                "axis.apiKey": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "API key for the Desmos Graphing Calculator. Leave blank to use Desmos’ public demo key, which works with no setup but logs a console warning and is not licensed for distribution. Get your own at https://www.desmos.com/api."
                },
                "axis.previewTarget": {
                    "type": "string",
                    "enum": [
                        "ask",
                        "editor",
                        "browser"
                    ],
                    "enumDescriptions": [
                        "Ask each time a preview is opened.",
                        "Open in a Simple Browser tab inside VSCode.",
                        "Open in your default browser."
                    ],
                    "default": "ask",
                    "markdownDescription": "Where **Axis: Preview Graph** opens the graph. Pinning a choice in the prompt sets this; set it back to `ask` to be asked again."
                },
                "axis.preview.debug": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Show the preview's **Graph** and **JSON** tabs and the path of the file on screen. Off, a preview is the graph and nothing else."
                },
                "axis.format.maxLineLength": {
                    "type": "number",
                    "default": 100,
                    "minimum": 0,
                    "markdownDescription": "Column the formatter breaks a long line at, counting its indentation. A statement is broken at a bracket, one entry to a line, which is the only place Axis lets one continue; a line made long by anything else — a note, a comment, a `# key: value` run — is left whole. Set to `0` to never break a line."
                }
            }
        },
        "menus": {
            "editor/title": [
                {
                    "command": "axis.preview",
                    "when": "resourceLangId == axis",
                    "group": "navigation"
                }
            ]
        }
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/vscode": "catalog:"
    },
    "dependencies": {
        "@axis-dsl/compiler": "workspace:*",
        "@axis-dsl/language": "workspace:*",
        "@axis-dsl/desmos": "workspace:*",
        "@axis-dsl/protocol": "workspace:*",
        "@axis-dsl/viewer": "workspace:*"
    },
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jayson-clark/axis.git",
        "directory": "packages/extension"
    }
}
