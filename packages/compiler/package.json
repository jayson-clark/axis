{
    "name": "@axis-dsl/compiler",
    "version": "2.2.0",
    "description": "Compiles .axis source into Desmos expressions and calculator settings",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "watch": "tsc --watch"
    },
    "dependencies": {
        "@axis-dsl/desmos": "workspace:*",
        "@axis-dsl/syntax": "workspace:*"
    },
    "license": "MIT",
    "author": "Jayson Clark",
    "homepage": "https://jayson-clark.github.io/axis/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jayson-clark/axis.git",
        "directory": "packages/compiler"
    },
    "bugs": {
        "url": "https://github.com/jayson-clark/axis/issues"
    },
    "keywords": [
        "axis",
        "axis-dsl",
        "desmos",
        "graphing",
        "dsl"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    }
}
