// ─────────────────────────────────────────────────────────────────────────────
// Styling - colour, lines, points, fills and labels
// ─────────────────────────────────────────────────────────────────────────────
//
// Every visual property is metadata after a #, or on a line of its own inside a
// #{ } block. Anything left out falls back to the Desmos default, so a
// statement only names what it changes.

config {
    lockViewport: false
}

"Styling"

folder "Line style" {
    y = x + 6 # color: #c74440, lineStyle: SOLID, lineWidth: 5
    y = x + 4 # color: #2d70b3, lineStyle: DASHED, lineWidth: 3
    y = x + 2 # color: #388c46, lineStyle: DOTTED, lineWidth: 3
    y = x # color: #6042a6, lineWidth: 8, lineOpacity: 0.35
}

folder "Point style" {
    "pointStyle: POINT, OPEN, CROSS"
    (-4, 4) # color: #c74440, pointStyle: POINT, pointSize: 20
    (-2, 4) # color: #2d70b3, pointStyle: OPEN, pointSize: 20
    (0, 4) # color: #388c46, pointStyle: CROSS, pointSize: 20
    "pointOpacity fades a point without hiding it"
    (2, 4) # color: #6042a6, pointSize: 30, pointOpacity: 0.3
    (4, 4) # color: #fa7e19, pointSize: 30, pointOpacity: 1
}

folder "Fills" {
    "fill shades the inside of a closed curve"
    x ^ 2 + y ^ 2 = 9 # color: #2d70b3, fill: true, fillOpacity: 0.25
    "lines: false keeps the fill and drops the outline"
    (x - 6) ^ 2 + y ^ 2 = 4 # color: #c74440, fill: true, fillOpacity: 0.5, lines: false
}

folder "Labels" {
    (0, 0) # color: #000000, label: "Origin", showLabel: true
    (3, 3) # color: #c74440, label: "Above", showLabel: true, labelOrientation: above
    (-3, 3) # color: #2d70b3, label: "Below", showLabel: true, labelOrientation: below
    (3, -3) # color: #388c46, label: "Bigger", showLabel: true, labelSize: 2
    "description is read by screen readers."
    (-3, -3) #{
        color: #6042a6
        showLabel: true
        label: "Described"
        description: "Lower left corner point"
    }
}

folder "Points or lines only" {
    "A list of points draws both by default"
    A = [(-5, -6), (-3, -5), (-1, -6), (1, -5)] # color: #fa7e19
    "points: false leaves the connecting path"
    B = [(-5, -8), (-3, -7), (-1, -8), (1, -7)] # color: #2d70b3, points: false
    "lines: false leaves the points"
    C = [(-5, -10), (-3, -9), (-1, -10), (1, -9)] # color: #388c46, lines: false
}
