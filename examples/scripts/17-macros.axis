// ─────────────────────────────────────────────────────────────────────────────
// Macros
// ─────────────────────────────────────────────────────────────────────────────
//
// A macro is a piece of source with a name. Wherever the name appears it is
// substituted away before anything is compiled, so Desmos never learns that a
// macro was involved - the graph is the one you would have written by hand.
//
// Two kinds. Without a parameter list it stands for a piece of text:
//
//     macro TAU 6.283185
//
// With one, it takes arguments and puts them into its body:
//
//     macro LERP(a, b, t) a + (b - a) * t
//
// The `(` has to touch the name. `macro ORIGIN (0, 0)` is a macro whose body is
// a point; `macro ORIGIN(0, 0)` would be one taking two parameters called `0`,
// which is why it is an error instead.

config {
    xmin: -7,
    xmax: 7,
    ymin: -3,
    ymax: 3
}

macro TAU 6.283185
macro SWATCH pointSize: 14, showLabel: true
macro WAVE(k, phase) sin(k * x + phase)

"Constants"

// A macro is not a variable: nothing named TAU reaches the graph, and the
// number is written into each expression that used it.
y = sin(TAU * x / 4) # color: #c74440, lineWidth: 3
period = TAU / 4 # color: #c74440

"Arguments"

// Substitution is textual, so an argument may be anything a statement may
// hold - a number, a name, an expression, another macro.
y = WAVE(1, 0) # color: #2d70b3
y = WAVE(2, TAU / 4) # color: #388c46
y = WAVE(1, 0) + WAVE(2, TAU / 4) # color: #6042a6, lineWidth: 3

// Arguments are bracketed where brackets settle precedence and nothing else,
// so this is sin(3 * (1 + 1) * x) rather than sin(3 * 1 + 1 * x).
y = WAVE(3 * (1 + 1), 0) # color: #fa7e19, lineOpacity: 0.4

"Metadata"

// A macro's body is text, and metadata is part of the line it is spliced into -
// so a run of properties written once can annotate as many statements as it is
// used on.
(-2, 1) # SWATCH, color: #c74440, label: "one"
(0, 1) # SWATCH, color: #2d70b3, label: "two"
(2, 1) # SWATCH, color: #388c46, label: "three"

// The `#` may sit in the body instead, which is the spelling to reach for when
// the macro is the whole of a statement's styling.
macro FAINT # color: #7b7b7b, lineOpacity: 0.35, lineStyle: DOTTED

y = x FAINT
y = -x FAINT

// A macro is in scope for the whole script, wherever it is written and whatever
// it is written above - so it belongs at the top level, outside every block.
macro CIRCLE(r) x ^ 2 + y ^ 2 = r ^ 2

folder "Everywhere a statement goes" {
    // A block is no different: the substitution happens first, and what comes
    // out of it is read as the folder's entries.
    CIRCLE(1) # color: #000000, lineStyle: DASHED
    CIRCLE(2) # color: #000000, lineOpacity: 0.3
}
