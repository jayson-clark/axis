// ─────────────────────────────────────────────────────────────────────────────
// Piecewise functions and domain restrictions
// ─────────────────────────────────────────────────────────────────────────────
//
// Braces hold a list of `condition: value` cases. The same syntax restricts a
// curve's domain when the braces hold conditions and nothing else.

"Piecewise and restrictions"

// One case per branch, read top to bottom.
step(x) = {x < 0: -1, x > 0: 1} # color: #c74440, lineWidth: 3

// A final value with no condition is the fallback.
clamp(x) = {x < 0: 0, x > 1: 1, x} # color: #2d70b3, lineWidth: 3

// Chained comparisons work inside a case.
pulse(x) = {-1 <= x <= 1: 1, 0} # color: #388c46, lineWidth: 3

// A brace group holding only conditions restricts the domain instead.
y = x ^ 2 {0 < x < 3} # color: #6042a6, lineWidth: 3

// Several restrictions are comma separated.
y = sin(x) {x > 0, x < 2pi} # color: #fa7e19, lineWidth: 3

// A long piecewise reads better split over lines.
wave(x) = {
    x < -pi: 0,
    -pi <= x <= pi: sin(x),
    x > pi: 0
} # color: #c74440, lineWidth: 3

folder "Absolute value, three ways" {
    y = abs(x) # color: #c74440
    y = {x < 0: -x, x} # color: #2d70b3, lineStyle: DASHED
    y = sqrt(x ^ 2) # color: #388c46, lineStyle: DOTTED
}
