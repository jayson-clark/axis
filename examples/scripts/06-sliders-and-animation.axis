// ─────────────────────────────────────────────────────────────────────────────
// Sliders and animation
// ─────────────────────────────────────────────────────────────────────────────
//
// A definition with sliderBounds becomes a slider. Give it playing: true and
// the graph animates as soon as it opens.

config {
    showGrid: true
}

"Sliders"

// min and max are required; step is optional.
a = 1 # sliderBounds: {min: -5, max: 5, step: 0.5}
b = 0 # sliderBounds: {min: -3, max: 3, step: 0.1}
c = 1 # sliderBounds: {min: 0.5, max: 4, step: 0.25}

"Drag a, b and c to reshape the parabola."

y = a * (x - b) ^ 2 + c # color: #c74440, lineWidth: 3

// The vertex, tracked as the sliders move.
(b, c) # color: #c74440, pointSize: 15, label: "vertex", showLabel: true, labelOrientation: above

folder "Animation" {
    "playing: true starts the slider moving on load."
    t = 0 # sliderBounds: {min: 0, max: 6.28, step: 0.02}, playing: true
    "A point riding the wave."
    (t, sin(t)) # color: #2d70b3, pointSize: 18
    y = sin(x) # color: #2d70b3, lineOpacity: 0.4
    "A trailing chord back to the origin."
    Q = [(0, 0), (t, sin(t))] # color: #fa7e19, points: false, lineStyle: DASHED
}
