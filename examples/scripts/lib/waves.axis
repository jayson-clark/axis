// ─────────────────────────────────────────────────────────────────────────────
// A library of waves, meant to be imported
// ─────────────────────────────────────────────────────────────────────────────
//
// Nothing about this file makes it a library: it is an ordinary script, and
// opening a preview on it graphs it on its own. What `import` does is drop the
// whole of it into another script, flattened into one folder - so the folders
// below are for reading this file, not for the graph it ends up in.

folder "Controls" {
    amp = 1 # sliderBounds: {min: 0, max: 3, step: 0.1},
    freq = 2 # sliderBounds: {min: 1, max: 8, step: 1}
}

folder "Waves" {
    sine(x) = amp * sin(freq * x) # color: #c74440,
    cosine(x) = amp * cos(freq * x) # color: #2d70b3,
    square(x) = amp * sign(sin(freq * x)) # color: #388c46
}
