// ─────────────────────────────────────────────────────────────────────────────
// An envelope to multiply a wave by
// ─────────────────────────────────────────────────────────────────────────────
//
// This one imports a library of its own. An import inside an imported file is
// flattened into the same folder as everything else it brings, since Desmos has
// only one level of folders to put things in.

import "./decay.axis"

envelope(x) = exp(-decay * abs(x)) # color: #6042a6, lineStyle: DASHED
