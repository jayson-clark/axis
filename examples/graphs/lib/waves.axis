// ─────────────────────────────────────────────────────────────────────────────
// A library of waves, meant to be imported
// ─────────────────────────────────────────────────────────────────────────────
//
// Nothing about this file makes it a library: it is an ordinary one, and
// opening a preview on it graphs it on its own. What `import` does is drop the
// whole of it into another file, flattened into one folder - so the folders
// below are for reading this file, not for the graph it ends up in.

folder "Controls" {
    amp = 1 @ slider: 0..3 step 0.1
    freq = 2 @ slider: 1..8 step 1
}

folder "Waves" {
    sine(x) = amp * sin(freq * x) @ color: RED
    cosine(x) = amp * cos(freq * x) @ color: BLUE
    square(x) = amp * sign(sin(freq * x)) @ color: GREEN
}
