// Base compiler options for every package that builds to CommonJS, and the
// solution file that builds them in order. Browser-bundled packages extend
// tsconfig.web.json instead. The viewer is one, but is still built here, ahead
// of the extension that imports its protocol. The extension itself is not: it
// is bundled by esbuild from its own `build` script, which `pnpm build` runs
// after this.
{
    "compilerOptions": {
        "target": "ES2020",
        "module": "node16",
        "moduleResolution": "node16",
        "lib": ["ES2020"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        // Ambient @types are opted into per package via "types"; nothing is
        // picked up implicitly from node_modules.
        "types": [],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "isolatedModules": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    // No inputs of its own: the packages below are what it builds.
    "files": [],
    "references": [
        { "path": "packages/desmos" },
        { "path": "packages/syntax" },
        { "path": "packages/language" },
        { "path": "packages/compiler" },
        { "path": "packages/language-service" },
        { "path": "packages/language-server" },
        { "path": "packages/viewer" },
        { "path": "packages/harness" }
    ]
}
